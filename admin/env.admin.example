# 管理后台配置：复制为项目根目录的 .env.admin，权限 600
# 账号和密码哈希用 scripts/admin/set-password.sh 生成，不要手写明文密码
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# 监听地址：127.0.0.1 只允许本机 / SSH 隧道访问；0.0.0.0 允许公网访问
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8090

# 通过 HTTPS 访问时改为 true，会话 Cookie 只在 HTTPS 下发送
ADMIN_COOKIE_SECURE=false

# 登录有效期（小时）
ADMIN_SESSION_HOURS=12

# 续火花配置和运行产物路径（相对项目根目录），一般不用改
# ADMIN_TASK_CONFIG=config.json
# ADMIN_ARTIFACTS_DIR=artifacts
